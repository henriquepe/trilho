{
  "name": "trilho",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:mcp": "esbuild mcp/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=mcp/dist/trilho-mcp.mjs --log-level=warning",
    "build:lambda": "node infra/build.mjs",
    "deploy": "npm run build:lambda && cd infra && sam deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/client-ssm": "^3.1172.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.73.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "description": "Local-first issue tracker for unlimited backlogs and projects"
}
